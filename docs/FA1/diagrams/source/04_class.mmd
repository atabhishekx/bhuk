    %% Order Entities
    class Order {
        @Id @GeneratedValue Long id
        @Column(unique) String orderNumber
        @ManyToOne User customer
        @ManyToOne Outlet outlet
        @Enumerated(STRING) OrderStatus status
        Integer subtotalMinor
        Integer taxMinor
        Integer deliveryFeeMinor
        Integer grandTotalMinor
        String deliveryAddressJson
        String idempotencyKey
        Instant createdAt
        Instant updatedAt
        List~OrderItem~ items
        List~OrderStatusEvent~ statusEvents
        Payment payment
        DeliveryAssignment deliveryAssignment
    }
    
    class OrderItem {
        @Id @GeneratedValue Long id
        @ManyToOne Order order
        @ManyToOne MenuItem item
        String itemNameSnapshot
        Integer quantity
        Integer unitPriceMinor
        Integer lineTotalMinor
        String instructions
        List~OrderItemModifier~ modifiers
    }
    
    class OrderItemModifier {
        @Id @GeneratedValue Long id
        @ManyToOne OrderItem orderItem
        String nameSnapshot
        Integer priceDeltaMinor
        Integer quantity
    }
    
    class OrderStatusEvent {
        @Id @GeneratedValue Long id
        @ManyToOne Order order
        String oldStatus
        String newStatus
        @ManyToOne User actor
        String actorRole
        String reason
        Instant createdAt
    }
    
    class IdempotencyRecord {
        @Id String recordKey
        @ManyToOne User actor
        String operation
        String requestHash
        Integer responseStatus
        String responseBody
        Instant createdAt
        Instant expiresAt
    }
    
    %% Order DTOs
    class CreateOrderRequest {
        @NotBlank @Size(max=128) String idempotencyKey
        @Valid @NotNull DeliveryAddressRequest deliveryAddress
        @NotBlank String deliveryAddressJson
    }
    
    class DeliveryAddressRequest {
        @NotBlank String fullAddress
        @NotBlank String city
        @NotBlank String state
        @NotBlank String pincode
        @NotBlank String phone
    }
    
    class OrderResponse {
