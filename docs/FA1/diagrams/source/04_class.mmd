    }
    
    class OrderItemResponse {
        Long id
        Long itemId
        String itemName
        Integer quantity
        Integer unitPriceMinor
        Integer lineTotalMinor
        String instructions
        List~OrderItemModifierResponse~ modifiers
    }
    
    class OrderItemModifierResponse {
        Long id
        String name
        Integer priceDeltaMinor
        Integer quantity
    }
    
    class OrderStatusEventResponse {
        Long id
        String oldStatus
        String newStatus
        Long actorId
        String actorName
        String actorRole
        String reason
        Instant createdAt
    }
    
    class OperationsReportResponse {
        Long totalOrders
        Long deliveredOrders
        Long cancelledOrders
        Integer totalRevenueMinor
        Double avgDeliveryTimeMinutes
    }
    
