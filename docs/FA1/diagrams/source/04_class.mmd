    %% Delivery Entities
    class DeliveryPartner {
        @Id @GeneratedValue Long id
        @OneToOne User user
        @ManyToOne Outlet outlet
        String vehicleType
        String vehicleNumber
        String licenseNumber
        @Enumerated(STRING) DeliveryPartnerStatus status
        BigDecimal currentLatitude
        BigDecimal currentLongitude
        Instant lastLocationUpdate
        Instant createdAt
        Instant updatedAt
    }
    
    class DeliveryAssignment {
        @Id @GeneratedValue Long id
        @OneToOne Order order
        @ManyToOne DeliveryPartner partner
        @Enumerated(STRING) DeliveryAssignmentStatus status
        Instant assignedAt
        Instant acceptedAt
        Instant pickedUpAt
        Instant deliveredAt
        Instant createdAt
        Instant updatedAt
        List~DeliveryTracking~ tracking
        List~DeliveryIssue~ issues
    }
    
    class DeliveryTracking {
        @Id @GeneratedValue Long id
        @ManyToOne DeliveryAssignment assignment
        BigDecimal latitude
        BigDecimal longitude
        Instant recordedAt
    }
    
    class DeliveryIssue {
        @Id @GeneratedValue Long id
        @ManyToOne DeliveryAssignment assignment
        @ManyToOne DeliveryPartner reportedByPartner
        String issueType
        String description
        Boolean resolved
        Instant createdAt
        Instant resolvedAt
    }
    
    %% Delivery DTOs
    class AssignPartnerRequest {
        Long orderId
    }
    
    class UpdateLocationRequest {
        @NotNull BigDecimal latitude
        @NotNull BigDecimal longitude
    }
    
    class SetAvailabilityRequest {
        @NotNull Boolean available
    }
    
    class ReportIssueRequest {
        @NotNull Long orderId
        @NotBlank String issueType
        String description
    }
    
    class DeliveryPartnerResponse {
        Long id
        String name
        String phone
        String status
        BigDecimal latitude
        BigDecimal longitude
    }
    
    class DeliveryAssignmentResponse {
        Long id
        Long orderId
        String orderNumber
        String status
        String customerName
        String customerPhone
        String deliveryAddressJson
        Instant assignedAt
    }
    
    class DeliveryTrackingResponse {
        Long id
        Long assignmentId
        BigDecimal latitude
        BigDecimal longitude
        Instant recordedAt
    }
    
    class OrderTrackingResponse {
        String orderNumber
        String status
        DeliveryPartnerResponse partner
        List~DeliveryTrackingResponse~ tracking
        Instant estimatedDelivery
    }
    
    %% ============ COMMON ============
    class ApiResponse~T~ {
        Boolean success
        T data
        String message
        String requestId
        +static <T> ApiResponse<T> success(T)
        +static <T> ApiResponse<T> success(T, String)
        +static ApiResponse<Void> ok(String)
    }
    
    class ErrorResponse {
        String code
        String message
        Map<String, String> details
        String requestId
    }
    
    class GlobalExceptionHandler {
        +handleValidation(ValidationException) ResponseEntity~ApiResponse~ErrorResponse~~
        +handleNotFound(NotFoundException) ResponseEntity~ApiResponse~ErrorResponse~~
        +handleConflict(ConflictException) ResponseEntity~ApiResponse~ErrorResponse~~
        +handleException(Exception) ResponseEntity~ApiResponse~ErrorResponse~~
    }
    
