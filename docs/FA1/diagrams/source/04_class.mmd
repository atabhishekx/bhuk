# Backend Class Diagram

```mermaid
classDiagram
    %% ============ CONFIG & SECURITY ============
    class WebConfig {
        +addCorsMappings(CorsRegistry)
    }
    
    class SecurityConfig {
        -JwtUtil jwtUtil
        -CustomUserDetailsService userDetailsService
        +PasswordEncoder passwordEncoder()
        +AuthenticationManager authenticationManager()
        +SecurityFilterChain filterChain(HttpSecurity, AuthenticationManager)
    }
    
    class JwtUtil {
        -String secret
        -Long expirationMs
        +String generateToken(UserDetails)
        +String extractUsername(String)
        +Boolean validateToken(String, UserDetails)
        +Claims extractAllClaims(String)
    }
    
    class JwtAuthenticationFilter {
        -JwtUtil jwtUtil
        -CustomUserDetailsService userDetailsService
        +doFilterInternal(HttpServletRequest, HttpServletResponse, FilterChain)
    }
    
    class CustomUserDetailsService {
        -UserRepository userRepository
        +loadUserByUsername(String) UserDetails
    }
    
    class UserDetailsImpl {
        +Long id
        +String email
        +String password
        +Collection~GrantedAuthority~ authorities
        +Boolean isEnabled
    }
    
    %% ============ AUTH MODULE ============
    class AuthController {
        -AuthService authService
        +login(AuthRequest) ResponseEntity~ApiResponse~AuthResponse~~
        +register(RegisterRequest) ResponseEntity~ApiResponse~Void~~
    }
    
    class AdminUserController {
        -UserService userService
        +assignRole(AssignRoleRequest) ResponseEntity~ApiResponse~Void~~
        +listUsers() ResponseEntity~ApiResponse~List~UserProfileResponse~~
    }
    
    class AuthService {
        -UserRepository userRepository
        -PasswordEncoder passwordEncoder
        -JwtUtil jwtUtil
        +AuthResponse login(AuthRequest)
        +Void register(RegisterRequest)
    }
    
    class UserService {
        -UserRepository userRepository
        -UserRoleRepository userRoleRepository
        -OutletRepository outletRepository
        +UserProfileResponse getProfile(String email)
        +Void assignRole(AssignRoleRequest)
        +List~UserProfileResponse~ listUsers()
    }
    
    %% Auth Entities
    class User {
        @Id @GeneratedValue Long id
        @Column(unique) String email
        String password
        String name
        String phone
        String status
        Instant createdAt
        Instant updatedAt
        List~UserRole~ roles
        List~UserAddress~ addresses
        Cart cart
    }
    
    class UserRole {
        @Id @GeneratedValue Long id
        @ManyToOne User user
        String role  "ADMIN|USER|OUTLET_STAFF|DELIVERY_GUY"
        @ManyToOne Outlet outlet
        Instant createdAt
    }
    
    class UserAddress {
        @Id @GeneratedValue Long id
        @ManyToOne User user
        String label
        String fullAddress
        String city
        String state
        String pincode
        String phone
        Boolean isDefault
        BigDecimal latitude
        BigDecimal longitude
    }
    
    class Outlet {
        @Id @GeneratedValue Long id
        String name
        String address
        String city
        String state
        String pincode
        BigDecimal latitude
        BigDecimal longitude
        String timezone
        String phone
        String status
        Instant createdAt
        Instant updatedAt
        List~OutletHours~ hours
        List~MenuCategory~ categories
        List~ModifierGroup~ modifierGroups
    }
    
    %% Auth DTOs
    class AuthRequest {
        @NotBlank @Email String email
        @NotBlank @Size(min=6) String password
    }
    
    class AuthResponse {
        String token
        UserProfileResponse user
    }
    
    class RegisterRequest {
        @NotBlank @Email String email
        @NotBlank @Size(min=6) String password
        @NotBlank String name
        String phone
        String role
    }
    
    class UserProfileResponse {
        Long id
        String email
        String name
        String phone
        List~String~ roles
    }
    
    class AssignRoleRequest {
        @NotNull Long userId
        @NotBlank String role
        Long outletId
    }
    
