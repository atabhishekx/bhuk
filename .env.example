# ==============================================================
# Restru — Environment Variables
# ==============================================================
# Copy this file to .env and fill in real values.
# NEVER commit a file containing real secrets to source control.
# ==============================================================

# --- Database (XAMPP MySQL defaults for development) ---
DB_HOST=localhost
DB_PORT=3306
DB_NAME=restru_db
DB_USERNAME=root
DB_PASSWORD=

# --- Server ---
SERVER_PORT=8080

# --- JWT (generate a strong random secret for production) ---
JWT_SECRET=CHANGE_ME_GENERATE_A_STRONG_RANDOM_SECRET
JWT_EXPIRATION_MS=86400000

# --- CORS ---
APP_CORS_ALLOWED_ORIGINS=http://localhost:5173

# --- Razorpay (sandbox credentials — do NOT use live keys here) ---
RAZORPAY_KEY_ID=rzp_test_PLACEHOLDER
RAZORPAY_KEY_SECRET=PLACEHOLDER_SECRET
RAZORPAY_WEBHOOK_SECRET=PLACEHOLDER_WEBHOOK_SECRET

# --- Logging ---
LOG_LEVEL=INFO

